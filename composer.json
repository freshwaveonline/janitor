{
    "name": "freshwaveonline/janitor",
    "description": "Janitor cleans up after your application: informative, white-label error pages for Laravel with message numbers, request IDs, retry countdowns, Livewire pop-ups and optional Filament branding.",
    "keywords": [
        "laravel",
        "janitor",
        "error-pages",
        "error-handling",
        "exceptions",
        "http-errors",
        "livewire",
        "filament",
        "white-label"
    ],
    "homepage": "https://github.com/freshwaveonline/janitor",
    "readme": "README.md",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincent van den Boogaard",
            "email": "mail@freshwave.online",
            "homepage": "https://freshwave.online",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/freshwaveonline/janitor/issues",
        "source": "https://github.com/freshwaveonline/janitor",
        "docs": "https://github.com/freshwaveonline/janitor#readme",
        "security": "https://github.com/freshwaveonline/janitor/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "nesbot/carbon": "^3.8.4",
        "symfony/http-kernel": "^7.2|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.5|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "suggest": {
        "livewire/livewire": "Render errors as a positioned pop-up instead of a full page during Livewire requests.",
        "filament/filament": "Inherit brand name, logo and primary colour from the active Filament panel."
    },
    "autoload": {
        "psr-4": {
            "FreshwaveOnline\\Janitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FreshwaveOnline\\Janitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ],
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis at the configured level.",
        "check": "Run every check CI runs: composer validation, code style, static analysis and tests.",
        "format": "Rewrite the code base with Laravel Pint.",
        "lint": "Report Laravel Pint violations without changing files.",
        "test": "Run the Pest test suite.",
        "test-coverage": "Run the Pest test suite with a coverage report."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FreshwaveOnline\\Janitor\\JanitorServiceProvider"
            ],
            "aliases": {
                "Janitor": "FreshwaveOnline\\Janitor\\Facades\\Janitor"
            }
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
